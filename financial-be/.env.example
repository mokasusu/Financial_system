# ==============================================================================
# FINANCIAL BACKEND - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and configure with your actual credentials
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=financial_system
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JWT Authentication
# Generate a secure 256-bit base64 secret (e.g. openssl rand -base64 32)
JWT_SECRET=your_base64_encoded_jwt_secret_key_minimum_256_bits
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Google OAuth2 Authentication (Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OCR Service Configuration (Microservice / FastAPI)
OCR_API_BASE_URL=http://localhost:8000
OCR_API_KEY=your_ocr_api_key
OCR_CONNECT_TIMEOUT_MS=10000
OCR_RESPONSE_TIMEOUT_SECONDS=600
OCR_MAX_UPLOAD_MB=25

# Financial Calculation Engine
CALCULATION_DEFAULT_SCALE=4
CALCULATION_ROUNDING_MODE=HALF_UP

# AI Interpretation & OpenRouter LLM
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_TIMEOUT_SECONDS=120

